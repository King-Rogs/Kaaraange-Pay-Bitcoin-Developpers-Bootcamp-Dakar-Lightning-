# ─────────────────────────────────────────────────────────────
# Kaaraange Pay — configuration du backend
# Copiez ce fichier en « .env » (même dossier) puis adaptez-le.
# Sans .env, tout fonctionne en mode simulé (aucun Polar requis).
# ─────────────────────────────────────────────────────────────

# --- Serveur ---------------------------------------------------
PORT=5000
# Adresse publique de l'interface (sert à construire le lien « mot de passe oublié »)
PUBLIC_URL=http://localhost:5173
# DEV_MODE=true : le lien de réinitialisation s'affiche à l'écran et dans la console
# (pas de serveur e-mail). À mettre à false en production.
DEV_MODE=true
# Premier administrateur : ce compte est promu admin à l'inscription ou au démarrage.
ADMIN_EMAIL=admin@kaaraange.sn
# Comptes de démonstration (Awa Couture, Fatou Ndiaye, Moussa Sarr — mot de passe demo1234)
SEED_DEMO=true
# Cookie « Secure » (à activer derrière HTTPS)
COOKIE_SECURE=false

# Hérités de connect-lnd (optionnels)
# API_KEY : protège les routes de passerelle /api/nodes/... (en-tête x-api-key ou Bearer)
# API_KEY=change-moi
# CORS_ORIGIN : origines autorisées, séparées par des virgules (inutile avec le proxy Vite)
# CORS_ORIGIN=http://localhost:5173

# Fichiers (chemins relatifs au dossier backend/)
DB_PATH=data/kaaraange.db
UPLOAD_DIR=uploads

# --- Lightning (LND) ------------------------------------------
# mock = réseau Lightning simulé en mémoire (alice → bob → carol)
# lnd  = vrais nœuds LND (Polar) via gRPC / ln-service
LND_MODE=mock
# Délais de réponse : un dépassement laisse l’opération financière en attente.
LND_RPC_TIMEOUT_MS=5000
LND_PAYMENT_TIMEOUT_MS=30000
LND_PATHFINDING_MS=10000

# Un nœud par rôle, au format de connect-lnd : hôte gRPC, macaroon admin en base64,
# certificat TLS en base64. Ports gRPC : onglet « Connect » de chaque nœud dans Polar.
# PowerShell : [Convert]::ToBase64String([IO.File]::ReadAllBytes("chemin\admin.macaroon"))
LND_NODE_ID_ACHETEUR=fatou
LND_GRPC_HOST_ACHETEUR=127.0.0.1:10001
LND_MACAROON_BASE64_ACHETEUR=
LND_TLS_CERT_BASE64_ACHETEUR=

LND_NODE_ID_VENDEUR=awa
LND_GRPC_HOST_VENDEUR=127.0.0.1:10002
LND_MACAROON_BASE64_VENDEUR=
LND_TLS_CERT_BASE64_VENDEUR=

LND_NODE_ID_LIVREUR=moussa
LND_GRPC_HOST_LIVREUR=127.0.0.1:10003
LND_MACAROON_BASE64_LIVREUR=
LND_TLS_CERT_BASE64_LIVREUR=

# --- Bitcoin Core ----------------------------------------------
# mock = chaîne regtest simulée ; rpc = bitcoind (Polar : backend1)
BTC_MODE=mock
# Le minage de 101 blocs peut dépasser le délai RPC ordinaire de 15 secondes.
BTC_MINE_TIMEOUT_MS=120000
# Port RPC de backend1 : onglet « Connect » de bitcoind dans Polar (18443 par défaut)
BTC_RPC_URL=http://127.0.0.1:18443
BTC_RPC_USER=polaruser
BTC_RPC_PASS=polarpass

# --- Cours BTC / FCFA ------------------------------------------
# live : Binance BTCEUR × 655,957, repli CoinGecko, puis BTC_XOF_FALLBACK
# fixed : toujours BTC_XOF_FALLBACK (utile hors ligne)
PRICE_MODE=live
BTC_XOF_FALLBACK=60000000

# --- Frais de livraison ----------------------------------------
# distance = haversine(boutique, livraison) × ROAD_FACTOR
# frais = FEE_BASE_XOF + FEE_PER_KM_XOF × km, arrondis à 25 F
ROAD_FACTOR=1.3
FEE_BASE_XOF=500
FEE_PER_KM_XOF=150
# Prix maximum d'un article, en sats (doit tenir dans le canal alice → bob)
ARTICLE_MAX_SAT=1000000

# --- Séquestre et livraison ------------------------------------
# Délai pour payer les 2 factures (minutes)
INVOICE_EXPIRY_MIN=30
# Délai de remise après paiement : au-delà, A et B sont annulées (remboursement total)
DEADLINE_MIN=120
# Délai de retour : au-delà, alerte et arbitrage admin ; les frais ne sont pas
# réglés sans confirmation du retour ou décision de l’administrateur.
RETURN_DEADLINE_MIN=120
# Durée minimale de blocage demandée aux HTLC, en blocs (288 ≈ 48 h à 10 min/bloc).
# Doit couvrir facture + livraison + retour + 12 blocs de marge.
# En regtest le temps dépend du minage manuel : ne pas miner 288 blocs en livraison.
HOLD_CLTV_DELTA=288
# Réessai des opérations financières persistantes et seuil des notes signalées.
RECOVERY_RETRY_SEC=5
LOW_RATING_THRESHOLD=3
# Rayon autour de la boutique pour « Colis récupéré » (km)
PICKUP_RADIUS_KM=0.5
# Rayon autour du point de livraison pour « Client absent » (km)
ABSENT_RADIUS_KM=0.5

# --- Livreurs et attribution ----------------------------------
# Durée d'une offre de course (secondes)
OFFER_SECONDS=30
# Période des boucles de fond : paiements, échéances, attribution, simulation (ms)
TICK_MS=2000

# --- Simulation (livreurs fictifs dans Dakar) -----------------
SIMULATION=false
SIM_BOTS=0
# Pas de déplacement en mode simulé, toutes les 2 s (km)
SIM_STEP_KM=0.25
# Les livreurs fictifs acceptent 85 % des offres après 3 s
SIM_ACCEPT_RATE=0.85
SIM_ACCEPT_DELAY_SEC=3
