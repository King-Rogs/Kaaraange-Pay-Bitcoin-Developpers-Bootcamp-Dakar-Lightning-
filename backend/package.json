{
  "name": "kaaraange-pay-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Kaaraange Pay — séquestre Lightning + livraison. Backend Express / ln-service, dérivé de la passerelle connect-lnd.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --watch --experimental-sqlite --no-warnings=ExperimentalWarning src/server.js",
    "test": "node --experimental-sqlite --no-warnings=ExperimentalWarning --test --test-reporter=spec test/flow.test.js test/features.test.js test/real-adapter.test.js test/bitcoin-rpc.test.js",
    "test:polar": "node --experimental-sqlite --no-warnings=ExperimentalWarning test/polar-validation.test.js",
    "demo:prepare": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/prepare-demo.js",
    "demo:scenarios": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/demo-scenarios.js",
    "demo:simulate": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/start-simulation.js",
    "test:polar:smoke": "node --experimental-sqlite --no-warnings=ExperimentalWarning test/polar.test.js",
    "test:bitcoin:polar": "node --experimental-sqlite --no-warnings=ExperimentalWarning test/bitcoin-polar.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ln-service": "^61.0.0",
    "multer": "^2.5.0"
  }
}
